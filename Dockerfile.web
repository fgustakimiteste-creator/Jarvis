FROM node:24-alpine AS build

RUN apk add --no-cache unzip
WORKDIR /build

COPY JARVIS-OS-V.2-main.zip /tmp/jarvis.zip
RUN unzip -q /tmp/jarvis.zip -d /build \
    && mkdir -p /app/web \
    && cp -a /build/JARVIS-OS-V.2-main/web/. /app/web/ \
    && rm -rf /build/JARVIS-OS-V.2-main /tmp/jarvis.zip

WORKDIR /app/web
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=https://jarvis-os-fgustakimiteste.onrender.com \
    NEXT_PUBLIC_WS_URL=wss://jarvis-os-fgustakimiteste.onrender.com

RUN npm ci --no-audit --no-fund \
    && npm run build

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=10000 \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=build /app/web/.next ./.next
COPY --from=build /app/web/node_modules ./node_modules
COPY --from=build /app/web/package.json ./package.json
COPY --from=build /app/web/next.config.ts ./next.config.ts

EXPOSE 10000
CMD ["sh", "-c", "npm run start -- --hostname 0.0.0.0 --port ${PORT:-10000}"]
