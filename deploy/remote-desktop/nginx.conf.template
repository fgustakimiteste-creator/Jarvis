server {
    listen ${PORT};
    server_name _;
    root /usr/share/novnc;
    access_log /dev/stdout combined;
    error_log /dev/stderr warn;

    auth_basic "JARVIS Original Desktop";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = / {
        try_files /remote.html =404;
    }

    location = /mic {
        proxy_pass http://127.0.0.1:8765/mic;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /speaker {
        proxy_pass http://127.0.0.1:8765/speaker;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # x11vnc in this image handles the WebSocket handshake itself.
    # Preserve the HTTP Upgrade and forward it directly to the native VNC socket.
    location = /vncws/websockify {
        proxy_pass http://127.0.0.1:5900;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location ^~ /vncws/ {
        alias /usr/share/novnc/;
        index vnc.html;
        try_files $uri $uri/ /vncws/vnc.html;
    }


}
